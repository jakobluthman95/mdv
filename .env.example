# mdv settings, in ~/.config/mdv/.env (or $XDG_CONFIG_HOME/mdv/.env).
# Easiest: run `mdv init`, which asks for each value and checks tokens.
# Or copy this file by hand:
#   mkdir -p ~/.config/mdv && cp .env.example ~/.config/mdv/.env && chmod 600 ~/.config/mdv/.env
# Every setting is optional. Real environment variables win over this file.
#
# To keep this file somewhere else (for example in your mdv clone, where
# .gitignore already excludes .env), point MDV_ENV_FILE at it from your shell
# profile. It can't be set inside this file:
#   echo 'export MDV_ENV_FILE=~/dev/mdv/.env' >> ~/.zshrc

# Docs folder mdv browses, pushes and shares from. Default: ~/dev/md
# MDV_DIR=~/dev/md

# --- Notion (mdv notion) ---
# Set this to talk to the Notion API directly with an internal integration
# secret (https://www.notion.so/profile/integrations). Pages must be shared
# with the integration (page ••• menu → Connections) before mdv can see them.
# Leave it unset to use the ntn CLI and its `ntn login` instead.
# NOTION_API_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- GitHub gists (mdv share) ---
# Set this to create gists with a personal access token: a fine-grained token
# with the account permission "Gists: Read and write", or a classic token with
# the "gist" scope (https://github.com/settings/tokens).
# Leave it unset to use the gh CLI and its `gh auth login` instead.
# GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
